# --- Pho Chu Map frontend configuration ---
# Copy to .env and fill in values as needed.

# Base URL of the backend API.
# Leave EMPTY in local development (the Vite dev server proxies /api to http://localhost:4000).
# Set to your deployed API URL when both are live, e.g.:
# VITE_API_URL=https://pho-chu-map-api.vercel.app
VITE_API_URL=

# Optional: point the Google Maps embed at your real location.
VITE_MAPS_EMBED_URL=

# --- Pho Chu Map server configuration (for Vercel deployment) ---
# MongoDB Atlas connection string (required for persistent data)
MONGODB_URI=

# JWT secret for admin authentication (use a strong random string in production)
JWT_SECRET=pho-chu-map-dev-secret-change-me

# Admin credentials for login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pho-chu-admin

# Cloudinary credentials for image uploads (optional but recommended)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=